# Required: Anthropic key for script / image-prompt / metadata generation
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Local transcription model size: tiny | base | small | medium | large-v3
WHISPER_MODEL_SIZE=small

# Optional: force a specific ffmpeg/ffprobe location. Leave blank to use the
# bundled copy (standalone app) or system PATH (dev mode).
FFMPEG_PATH=
FFPROBE_PATH=
